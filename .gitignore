# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration Lovable — données réelles d'utilisateurs, jamais commitées
/migration-data/
/migration-report*.csv
/migration-report*.json

# dossiers de maquettes design déposés à la racine (exports d'outils
# de design, hors périmètre du code applicatif)
/3 Istanbul design 2/
/Asia design proparjour/
/Claude Istanbul 1/
/110790prodesign/

# copie de sauvegarde du projet, jamais compilée ni commitée
# (exclue aussi de tsconfig.json)
/_archive/

# état local du CLI Supabase (lien de projet, versions détectées) —
# jamais du code source, jamais commité
/supabase/.temp/
