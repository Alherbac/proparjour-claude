# Copier ce fichier en .env.local (ignoré par git) et renseigner les
# vraies valeurs depuis le dashboard Supabase du projet (région UE).

# Sûres à exposer au navigateur (préfixe NEXT_PUBLIC_ requis pour l'accès client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — ne jamais préfixer NEXT_PUBLIC_, ne jamais utiliser côté client.
# Utilisable uniquement dans src/lib/supabase/admin.ts (Route Handlers / Server Actions).
SUPABASE_SERVICE_ROLE_KEY=

# OAuth Google — identifiants créés sur Google Cloud Console, à
# configurer dans Supabase Auth > Providers (pas directement utilisés
# par le code Next.js, Supabase gère le flux OAuth lui-même).

# Stripe (mode test) — clés du dashboard.stripe.com/test/apikeys.
# La clé publique est sûre côté navigateur, la clé secrète ne doit
# jamais l'être (utilisée uniquement dans src/lib/stripe/server.ts).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
